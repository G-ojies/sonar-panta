PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
PANTA_API_KEY=pk_live_...
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Solami (optional, server-side only): with a key, tape rebuilds use Solami RPC and the live tape stream uses Solami WebSocket. See docs/SOLAMI.md
SOLAMI_API_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
ANTHROPIC_API_KEY=
SONAR_AGENT_MODE=paper
# Local file store shared by the dev server and scripts
SONAR_STORE_FILE=.sonar-store.json
