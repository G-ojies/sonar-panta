PANTA_API_BASE_URL=https://live-api.panta.market/api/v1
PANTA_API_KEY=pk_live_...
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta
# Chain data path (optional, server-side only). One provider at a time: RPC Fast when RPCFAST_API_KEY is set (docs/RPCFAST.md),
# else Solami when SOLAMI_API_KEY is set (docs/SOLAMI.md); CHAIN_PROVIDER=rpcfast|solami picks when both are set. No key: public endpoints.
RPCFAST_API_KEY=
SOLAMI_API_KEY=
KV_REST_API_URL=
KV_REST_API_TOKEN=
ANTHROPIC_API_KEY=
SONAR_AGENT_MODE=paper
# Local file store shared by the dev server and scripts
SONAR_STORE_FILE=.sonar-store.json
